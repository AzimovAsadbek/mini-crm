# --- Database ---------------------------------------------------------------
# Docker bilan (loyiha ildizida `docker compose up -d`):
DATABASE_URL="postgresql://minicrm:minicrm@localhost:5434/mini_crm?schema=public"
# Lokal PostgreSQL bilan ishlasangiz o'rniga shuni yozing:
# DATABASE_URL="postgresql://postgres:PAROL@localhost:5432/mini_crm?schema=public"

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL=60000
THROTTLE_LIMIT=200
